{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VinaNote Offline",
  "version": "1.0.0",
  "identifier": "local.vinanote.offline",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VinaNote Offline — Dịch Video, Họp & Ghi chú AI 100% Nội bộ",
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/vinanote-audiocap"
    ],
    "macOS": {
      "minimumSystemVersion": "14.2"
    }
  }
}
