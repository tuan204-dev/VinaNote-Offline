{
  "manifest_version": 3,
  "name": "VinaNote Offline — Dịch Video YouTube, TikTok, Bilibili 100% Nội bộ",
  "version": "1.0.0",
  "description": "Dịch phụ đề & thuyết minh tiếng Việt thời gian thực cho YouTube, TikTok, Douyin, Bilibili, Facebook bằng AI chạy 100% trên máy Mac (Offline).",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VinaNote Offline — Dịch & Thuyết minh Video",
    "default_icon": {
      "32": "icons/32x32.png",
      "128": "icons/128x128.png"
    }
  },
  "icons": {
    "32": "icons/32x32.png",
    "128": "icons/128x128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
